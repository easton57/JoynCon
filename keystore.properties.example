# Copy to keystore.properties (git-ignored) and fill in to sign Play release builds.
# Generate an upload key with:
#   keytool -genkeypair -v -keystore joyncon-upload.jks -keyalg RSA -keysize 4096 -validity 10000 -alias upload
storeFile=joyncon-upload.jks
storePassword=
keyAlias=upload
keyPassword=
